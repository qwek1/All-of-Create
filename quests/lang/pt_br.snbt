	quest.152333F57A5C1913.quest_subtitle: "Um &6Laminador&r serve para laminar materiais brutos em componentes úteis, como varas e fios"
	quest.155F388D56FB4A5F.quest_subtitle: "&6Serras Mecânicas&r podem derrubar árvores ou permitir que engenhocas derrubem árvores, além de executar receitas como cortar blocos ou descascar &aTroncos&r"
	quest.155FBDDA1C6194CA.quest_subtitle: "Um &6Controle de Engenhoca&r permite que você desligue partes de engenhocas enquanto elas estão montadas"
	quest.157DAE6EC4155F82.quest_subtitle: "Pode ser encontrado em cavernas, ou misturado com Mel e Lava"
